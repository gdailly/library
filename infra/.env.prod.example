# Serveur : copier ce fichier en infra/.env (ignoré par Git) puis renseigner les valeurs.
# Guide pas à pas : docs/deploiement.md

# Adresse du site
#   - nom de domaine (ex. livre.duckdns.org) : HTTPS, certificat Let's Encrypt obtenu et renouvelé automatiquement
#   - :80 : HTTP simple sur l'IP du serveur, sans certificat (Android seulement, la connexion Google web exige HTTPS)
SITE_ADDRESS=:80

# MariaDB (mots de passe longs et aléatoires : openssl rand -base64 24)
MARIADB_DATABASE=livre
MARIADB_USER=livre
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# Authentification Google
# Client ID OAuth « Application Web » (utilisé par le site et comme server client ID sur Android)
GOOGLE_CLIENT_ID=
# Client IDs acceptés par le backend (séparés par des virgules) : au minimum le client ID web ci-dessus
GOOGLE_CLIENT_IDS=
# E-mail du premier propriétaire de la bibliothèque
BOOTSTRAP_OWNER_EMAIL=

# Recherche ISBN : clé d'API Google Books (recommandée)
GOOGLE_BOOKS_API_KEY=

# Couvertures : secret de signature des URL (openssl rand -base64 48)
COVER_URL_SECRET=change-me

# Reconnaissance IA (lots 2 et 3)
RECOGNITION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

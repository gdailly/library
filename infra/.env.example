# Copier ce fichier en .env et renseigner les valeurs

# MariaDB
MARIADB_DATABASE=livre
MARIADB_USER=livre
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# Authentification Google (client IDs OAuth, séparés par des virgules)
GOOGLE_CLIENT_IDS=
# E-mail du premier propriétaire de la bibliothèque
BOOTSTRAP_OWNER_EMAIL=
# Origines autorisées pour le frontend web (séparées par des virgules), ex. http://localhost:5000
CORS_ALLOWED_ORIGINS=

# Recherche ISBN : clé d'API Google Books (recommandée, le quota anonyme est vite épuisé)
GOOGLE_BOOKS_API_KEY=

# Couvertures : secret de signature des URL (chaîne aléatoire longue)
COVER_URL_SECRET=change-me

# Reconnaissance IA (lots 2 et 3)
RECOGNITION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

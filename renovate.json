{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "One weekly PR for minor and patch updates of stable dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "minor and patch updates"
    },
    {
      "description": "Stay on Java 25 (LTS): Temurin images and toolchain move together, by hand",
      "matchDatasources": ["docker"],
      "matchDepNames": ["eclipse-temurin"],
      "allowedVersions": "<26"
    },
    {
      "description": "Same MariaDB image in docker-compose and Testcontainers",
      "matchDatasources": ["docker"],
      "matchDepNames": ["mariadb"],
      "groupName": "MariaDB"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "MariaDB image used by Testcontainers",
      "managerFilePatterns": ["/backend/src/test/java/.+/TestcontainersConfiguration\\.java$/"],
      "matchStrings": ["MARIADB_IMAGE = \"(?<depName>mariadb):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ]
}
